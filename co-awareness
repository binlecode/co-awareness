#!/usr/bin/env zsh
set -euo pipefail

readonly APP_CMD_NAME="co-awareness"

# Absolute, symlink-resolved path of THIS script. The app re-execs it for the update prompt's
# Restart button (exported as CO_AWARENESS_LAUNCHER below), and it is also where the
# script dir comes from — one resolution, so the two can't disagree. Resolving through the
# symlink matters: the PATH entry install.sh creates is ~/.local/bin/co-awareness
# pointing into the install dir, and a restart has to run the real file, not the link's name
# joined to the real dir.
resolve_script_path() {
  local source dir
  # In zsh functions, $0 is the function name; %x is the current script path.
  source="${(%):-%x}"

  if [[ "$source" != */* ]]; then
    source="$(command -v -- "$source" || true)"
    if [[ -z "$source" ]]; then
      print -u2 "$APP_CMD_NAME: unable to resolve script path"
      return 1
    fi
  fi

  while [[ -h "$source" ]]; do
    dir="$(cd -P -- "$(dirname -- "$source")" && pwd)"
    source="$(readlink -- "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done

  dir="$(cd -P -- "$(dirname -- "$source")" && pwd)" || return 1
  print -- "$dir/${source:t}"
}

# The one help text lives in the binary (Config.printUsage), which reads its lists from code and
# presets.json, so the launcher keeps no copy to drift. Also the exit for every command the binary
# answers on its own — status, snapshot, presets, and any word it refuses — with no guard and no
# compile in front: none of them writes or locks anything, and all must run beside a live instance.
exec_binary() {
  if [[ ! -x "$swift_bin" ]]; then
    print -u2 "$APP_CMD_NAME: no binary yet; build one with \`$APP_CMD_NAME build\`."
    exit 2
  fi
  CO_AWARENESS_BIN_NAME="$APP_CMD_NAME" exec "$swift_bin" "$@"
}

# TEMPORARY BRIDGE — delete with its ROADMAP row. Builds before the verb-first grammar emit argv of
# their own that the grammar refuses: the self-updater runs `launcher --precompile`, its Restart runs
# `launcher <preset> --load-source …`, and a login item bakes `launcher --no-detach … <preset> …`
# (older ones also `--label <mode>`).
# Those processes are already on disk and cannot be changed, so they are read here, once, with a
# stderr note; the running app then rewrites the login item (Restarter.migrateLegacyLoginItem). Only
# those shapes: any other old spelling reaches the binary and is refused with its replacement.
legacy_argv() {
  local arg prev="" rewritten=0
  LEGACY_ARGV=()
  if [[ $# -eq 1 && "$1" == "--precompile" ]]; then
    LEGACY_ARGV=(build)
    print -u2 "$APP_CMD_NAME: read legacy \`--precompile\` as \`build\`."
    return
  fi
  if [[ " $* " != *" --no-detach "* ]] \
     && [[ $# -eq 0 || "$1" == -* || "$1" == (start|status|snapshot|presets|build|set) ]]; then
    LEGACY_ARGV=("$@")
    return
  fi
  for arg in "$@"; do
    if [[ "$prev" == "--label" ]]; then
      case "${arg:l}" in
        value) LEGACY_ARGV+=(--display value) ;;
        chart|trace) LEGACY_ARGV+=(--display trace) ;;
        *) LEGACY_ARGV+=(--display gif) ;;
      esac
    elif [[ "$arg" == "--label" ]]; then
      rewritten=1
    elif [[ "$arg" == "--no-detach" ]]; then
      LEGACY_ARGV+=(--foreground); rewritten=1
    elif [[ "$arg" == -* || "$prev" == (--speed-multiplier|--display|--load-source|--keep-awake|--keep-awake-pid|--battery-threshold) ]]; then
      LEGACY_ARGV+=("$arg")
    else
      LEGACY_ARGV+=(--preset "$arg"); rewritten=1
    fi
    prev="$arg"
  done
  if (( rewritten )); then
    print -u2 "$APP_CMD_NAME: read legacy arguments as: ${LEGACY_ARGV[*]}"
  fi
}

# Compiles CoAwareness.swift to the sibling binary when the source is newer (or the binary is
# missing). Returns 0 when the binary is current — already, or after a successful build — and 1 when
# swiftc failed, which is the caller's cue to fall back to the interpreted `swift`.
#
# -strict-concurrency=complete opts into full data-race checking (Swift 5 mode, so violations
# surface as warnings rather than breaking the build). The source is annotated @MainActor to satisfy
# it; see docs for the concurrency posture.
#
# The build goes to a temp and is renamed into place, never written over the binary directly:
# `build` exists to run *while an instance is live*, and overwriting a running Mach-O in place
# corrupts the process paging out of it. rename(2) within one directory is atomic and leaves the live
# process holding its old inode. `tests/qa.sh` §6 asserts the live instance survives a rebuild.
compile_if_stale() {
  local swift_src="$1" swift_bin="$2"
  if [[ -x "$swift_bin" && ! "$swift_src" -nt "$swift_bin" ]]; then
    return 0
  fi
  if swiftc -O -strict-concurrency=complete "$swift_src" -o "$swift_bin.new" >/dev/null 2>&1; then
    mv -f -- "$swift_bin.new" "$swift_bin"
    return 0
  fi
  rm -f -- "$swift_bin.new"
  return 1
}

main() {
  local script_dir launcher_path swift_module_cache
  local launch_detached=1
  local allow_extra=0
  local log_file pid arg rc log_json
  local -a passthrough_args swift_cmd existing_pids
  typeset -ga LEGACY_ARGV

  launcher_path="$(resolve_script_path)"
  script_dir="${launcher_path:h}"
  local swift_src="$script_dir/CoAwareness.swift"
  local swift_bin="$script_dir/CoAwareness"

  legacy_argv "$@"
  set -- "${LEGACY_ARGV[@]}"

  # Help, and the spellings the binary refuses with a pointer to their replacement, go straight to it:
  # on the start path below they would be compiled and detached, and the refusal would land in a log.
  for arg in "$@"; do
    case "$arg" in
      -h|--help|--once|--status|--set|--precompile|--label|--detach) exec_binary "$@" ;;
    esac
  done

  case "${1:-}" in
    build)
      # Build and stop. This is the app's half of a self-update — `git pull` moves the source, and the
      # compile that makes it runnable has to happen *before* the app quits, or the user watches an
      # empty menu bar for as long as swiftc takes (measured 6.5s warm, 32s on a cold clang module
      # cache, 132s once under load). Deliberately ahead of the singleton guard: its whole purpose is
      # to run while an instance is live, which is what the temp+rename in compile_if_stale is for.
      if [[ $# -gt 1 ]]; then
        print -u2 "$APP_CMD_NAME: \`build\` takes no arguments."
        exit 1
      fi
      if compile_if_stale "$swift_src" "$swift_bin"; then
        exit 0
      fi
      print -u2 "$APP_CMD_NAME: swiftc failed; the next launch compiles on demand or falls back to interpreted swift."
      exit 1
      ;;
    start)
      shift
      ;;
    ""|-*)
      ;;
    *)
      exec_binary "$@"
      ;;
  esac

  if ! command -v swift >/dev/null 2>&1; then
    print -u2 "$APP_CMD_NAME: swift command not found"
    exit 127
  fi

  swift_module_cache="${SWIFT_MODULE_CACHE:-/tmp/swift-module-cache}"

  passthrough_args=()
  for arg in "$@"; do
    case "$arg" in
      --foreground)
        launch_detached=0
        ;;
      --extra)
        # The binary needs it too: it runs its own resident check before booting a GUI.
        allow_extra=1
        passthrough_args+=("$arg")
        ;;
      *)
        passthrough_args+=("$arg")
        ;;
    esac
  done

  # The singleton guard, ahead of the compile, so a second `start` costs a pgrep rather than a full
  # swiftc run — and, when the source is stale, so it can't start a second build racing the one
  # whose gap it wandered into.
  if (( ! allow_extra )); then
    # Match the compiled binary by its path — `/CoAwareness` followed by a space (it has args) or
    # end-of-line (no args). The trailing `( |$)` keeps this from matching an editor holding
    # `CoAwareness.swift` open, or a `swiftc`/`swift` build of the source. (The interpreted
    # `swift …/CoAwareness.swift` fallback, used only when swiftc fails, is intentionally not
    # singleton-guarded.) pgrep -f excludes its own process; the lowercase launcher path
    # `co-awareness` never matches this pattern.
    #
    # `-U "$(id -u)"` scopes the search to the calling user: plain `pgrep -f` sees every user's
    # processes, so with fast user switching this refused user B's *first* launch by naming a PID in
    # user A's session — one B can't see, click, or kill. The guard means "don't stack instances in
    # *my* menu bar", and the menu bar is per-session.
    existing_pids=($(pgrep -U "$(id -u)" -f "/CoAwareness( |$)" || true))
    if [[ ${#existing_pids[@]} -gt 0 ]]; then
      # `start` is idempotent: with an instance up, the settings go to it instead of a second one.
      # No compile on this path — the resident process is the previous build, and the binary on disk
      # was built from it. --foreground has no live meaning, so it is refused rather than dropped.
      if (( ! launch_detached )); then
        print -u2 "$APP_CMD_NAME: --foreground only takes effect when an instance starts, and one is running (PID: ${existing_pids[*]}). Quit it first, or pass --extra for a second instance. Nothing was changed."
        exit 1
      fi
      if [[ ! -x "$swift_bin" ]]; then
        print -u2 "$APP_CMD_NAME: an instance is running but there is no binary to reach it with; build one with \`$APP_CMD_NAME build\`."
        exit 2
      fi
      # Run as a child, not exec'd: exit 3 means the instance pgrep saw is gone by the time the binary
      # looked, and the launch below is then the right answer rather than a GUI attached to this shell.
      rc=0
      CO_AWARENESS_BIN_NAME="$APP_CMD_NAME" CO_AWARENESS_FORWARD_ONLY=1 \
        "$swift_bin" start "${passthrough_args[@]}" || rc=$?
      if (( rc != 3 )); then
        exit $rc
      fi
    fi
  fi

  if compile_if_stale "$swift_src" "$swift_bin"; then
    swift_cmd=("$swift_bin" "${passthrough_args[@]}")
  else
    mkdir -p -- "$swift_module_cache"
    swift_cmd=(swift -strict-concurrency=complete -module-cache-path "$swift_module_cache" "$swift_src" "${passthrough_args[@]}")
  fi

  # CO_AWARENESS_LAUNCHER / _LAUNCH_MODE are how the app answers "can I restart myself, and
  # how" for the update prompt's Restart button — it cannot infer that on its own, because a
  # detached run and a launchd-supervised one both reparent to pid 1. `detached` means "re-exec this
  # launcher once I've exited"; `attached` means the caller is waiting on us, so the app offers a
  # restart only when launchd is the caller — asked via `launchctl list`, NOT sniffed from
  # XPC_SERVICE_NAME, which a LaunchAgent job reports as "0" — and never steals a --foreground run
  # out from under the shell that started it. LAUNCHER is also what the app runs `build` through, so
  # the swiftc invocation lives in this file only.
  if (( launch_detached )); then
    log_file="${CO_AWARENESS_LOG_FILE:-/tmp/co-awareness.log}"
    mkdir -p -- "$(dirname -- "$log_file")"
    CO_AWARENESS_BIN_NAME="$APP_CMD_NAME" \
    CO_AWARENESS_LAUNCHER="$launcher_path" \
    CO_AWARENESS_LAUNCH_MODE="detached" \
      nohup "${swift_cmd[@]}" >>"$log_file" 2>&1 < /dev/null &
    pid=$!
    disown "$pid" 2>/dev/null || true
    log_json="${log_file//\\/\\\\}"
    log_json="${log_json//\"/\\\"}"
    print -r -- "{\"action\":\"started\",\"pid\":$pid,\"log\":\"$log_json\"}"
    exit 0
  fi

  CO_AWARENESS_BIN_NAME="$APP_CMD_NAME" \
  CO_AWARENESS_LAUNCHER="$launcher_path" \
  CO_AWARENESS_LAUNCH_MODE="attached" \
    exec "${swift_cmd[@]}"
}

main "$@"
